diff --git a/container/container_ffmpeg.c b/container/container_ffmpeg.c
index 743a366..d7ddde5 100755
--- a/container/container_ffmpeg.c
+++ b/container/container_ffmpeg.c
@@ -2505,6 +2505,21 @@ static int AudioTranscoderTarget(AVStream *stream, const char *encoding)
     else if (id == AV_CODEC_ID_TRUEHD || id == AV_CODEC_ID_MLP)
         dolby = truehd_ac3_transcode;
 
+    /* Dreambox: Dolby Digital at a sample rate other than 48 kHz (AC-3 44.1 kHz
+     * dubs) to AC3 5.1 at 48 kHz. Passed through, the change of the HDMI
+     * output from 48 kHz (PCM, other tracks) to 44.1 kHz made the sound of
+     * soundbars and receivers (HDMI ARC) stutter until the next seek, also
+     * at a clean start. EP3_AC3_48K=0 in the environment turns it off. */
+    else if ((id == AV_CODEC_ID_AC3 || id == AV_CODEC_ID_EAC3) &&
+             (!strcmp(encoding, "A_AC3") || !strcmp(encoding, "A_EAC3")) &&
+             get_codecpar(stream)->sample_rate > 0 && get_codecpar(stream)->sample_rate != 48000 &&
+             STB_DREAMBOX == GetSTBType())
+    {
+        const char *env = getenv("EP3_AC3_48K");
+        if (!env || strcmp(env, "0"))
+            dolby = 1;
+    }
+
     if (dolby)
         /* AC3 also when E-AC-3 is asked for and its encoder is missing */
         target = (dolby == 2 && (audio_transcode_caps() & AUDIO_XCODE_EAC3)) ? AUDIO_XCODE_EAC3 : AUDIO_XCODE_AC3;
