diff --git a/playback/playback.c b/playback/playback.c
index 4d4c7e2..087f33f 100755
--- a/playback/playback.c
+++ b/playback/playback.c
@@ -762,6 +762,24 @@ static int32_t PlaybackSwitchAudio(Context_t  *context, int32_t *track)
                     ret = context->output->audio->Command(context, OUTPUT_SWITCH, (void*)"audio");
                 if (ret < 0)
                     playback_err("failed to switch audio output\n");
+                /* Dreambox: the seek of the container switch has cleared both
+                 * decoders, the picture runs on and the audio decoder is started
+                 * for the new codec only afterwards, into the running clock. A
+                 * pass-through track at another sample rate (AC-3 44.1 kHz after
+                 * PCM 48 kHz from TrueHD) then stuttered until the next seek.
+                 * One more seek to the position starts both decoders together. */
+                else if (STB_DREAMBOX == GetSTBType() && !context->playback->isDash &&
+                         !context->playback->isPaused && !context->playback->isForwarding &&
+                         !context->playback->BackWard && !context->playback->SlowMotion)
+                {
+                    int64_t length = 0, sec = 0;
+                    if (PlaybackLength(context, &length) == 0 && length > 0)
+                    {
+                        playback_printf(10, "seek after the audio switch\n");
+                        if (PlaybackSeek(context, &sec, 0) < 0)
+                            playback_err("seek after the audio switch failed\n");
+                    }
+                }
             }
         }
         context->playback->isSeeking = wasSeeking;
