Dreambox: send VP9 in 32 kB PES chunks.
VP9 frames (4K up to ~900 kB) written as one PES break the picture on
the DM900; the chunked path used for other Broadcom boxes plays fine.

diff --git a/output/writer/mipsel/vp.c b/output/writer/mipsel/vp.c
index 2488542..4c11820 100755
--- a/output/writer/mipsel/vp.c
+++ b/output/writer/mipsel/vp.c
@@ -130,7 +130,9 @@ static int writeData(void *_call, bool is_vp6, bool is_vp9)
 
     int32_t payload_len = call->len + pes_header_len - 6;
 
-    if (!is_vp9 || STB_VUPLUS == GetSTBType() || STB_HISILICON == GetSTBType() || STB_DREAMBOX == GetSTBType()) {
+    /* Dreambox: VP9 frames over 64 kB in one PES break the picture, send them
+     * in 32 kB chunks like other Broadcom boxes (tested on DM900, 4K YouTube). */
+    if (!is_vp9 || STB_VUPLUS == GetSTBType() || STB_HISILICON == GetSTBType()) {
         UpdatePesHeaderPayloadSize(PesHeader, payload_len);
         // it looks like for VUPLUS drivers PES header must be written separately
         int ret = call->WriteV(call->fd, iov, 1);
